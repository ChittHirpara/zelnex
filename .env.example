# ==============================================================================
# Zelnex Pharmaceuticals - Enterprise Production Environment Configuration
# ==============================================================================

# Public Canonical Site URL (Required for sitemaps, OpenGraph, canonical links)
NEXT_PUBLIC_SITE_URL=https://zelnexpharma.com

# Notification & Email Routing (Optional - Resend API Key)
# If left unset, inquiries and RFQs will log to structured server audit records
RESEND_API_KEY=re_your_api_key_here

# Internal Export Desk Notification Email
NOTIFICATION_EMAIL=export@zelnexpharma.com

# Webhook Endpoint (Optional - Slack / Microsoft Teams / CRM lead webhook)
DISPATCH_WEBHOOK_URL=https://hooks.slack.com/services/...

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=600000

# Google Search Console Verification Token (Optional)
NEXT_PUBLIC_GSC_VERIFICATION=your_google_site_verification_token
